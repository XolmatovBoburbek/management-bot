# Токен от @BotFather
BOT_TOKEN=

# Публичный HTTPS-адрес Mini App (без / в конце). Например: https://iacpm.westeurope.cloudapp.azure.com
# Без него бот работает, но кнопки «Открыть кабинет» не будет.
WEBAPP_URL=

# Для docker-compose с Caddy: домен, на который Caddy выпустит сертификат (обычно тот же, что в WEBAPP_URL, без https://)
DOMAIN=

TIMEZONE=Asia/Tashkent
PORT=8080

# Необязательно: JSON-ключ сервисного аккаунта Google — чтобы бот записывал статусы обратно в Google Таблицу.
# В docker-compose положите файл в ./secrets/google.json и раскомментируйте строку ниже.
# GOOGLE_CREDENTIALS_FILE=/secrets/google.json
